    "jsdom": "^30.1.2",
    "prettier": "^3.3.0",
    "turbo": "^2.1.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.8.0"
}